# Runtime
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Local development database (matches compose.yml)
DATABASE_URL=postgresql://researchweave:researchweave@localhost:5432/researchweave

# Optional server-only OpenAI-compatible summary generation
# LLM_BASE_URL=https://provider.example/v1
# LLM_API_KEY=replace-with-a-server-only-key
# LLM_MODEL=provider-model-id

# Server-local durable original document storage (never publicly served)
DOCUMENT_STORAGE_DIR=./data/documents
