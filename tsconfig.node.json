{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "server",
    "scripts",
    "shared",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "eslint.config.js"
  ]
}
